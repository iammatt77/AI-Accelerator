# ─────────────────────────────────────────────────────────────
# AI Consulting rendszer — foundation csomag
# Másold .env.local-ba (az gitignore-olt) és töltsd ki.
# ─────────────────────────────────────────────────────────────

# LLM — direkt Anthropic API. SZERVEROLDALI, sosem kerül kliensre.
# A hívás kizárólag a lib/llm adapteren keresztül történhet.
ANTHROPIC_API_KEY=

# Opcionális: a generáláshoz használt modell (default: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Supabase (EU / Frankfurt régió) — szerveroldali service-role.
# Ezek SOSEM kerülnek a böngésző-bundle-be.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — böngésző-anon kliens (publikus, RLS védi).
# A NEXT_PUBLIC_ prefix miatt ezek elérhetők a kliensen.
# Értékük megegyezik a Supabase projekt URL-jével és anon kulcsával.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A spec §5 SUPABASE_ANON_KEY néven hivatkozik rá; a böngésző-kliens a
# NEXT_PUBLIC_SUPABASE_ANON_KEY-t olvassa. Add meg mindkettőt azonos értékkel,
# vagy csak a NEXT_PUBLIC_ változatot.
SUPABASE_ANON_KEY=
